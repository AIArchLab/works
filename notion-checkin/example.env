# Copy to .env and fill in your own values. Do not commit real secrets.
CHECKIN_TOKEN=
CHECKIN_DATABASE_ID=

# Property mapping (defaults shown)
CHECKIN_PROP_TITLE=Name
CHECKIN_PROP_AGENT=Agent
CHECKIN_PROP_STATUS=Status
CHECKIN_PROP_DATE=Date
CHECKIN_PROP_NOTES=Notes
CHECKIN_PROP_SOURCE=Source

# Optional
CHECKIN_STATUS_VALUE=Active
CHECKIN_TZ_OFFSET=+00:00
CHECKIN_LOCAL_LOG=./checkin.jsonl
