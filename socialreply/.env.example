# Copy to .env locally. Never commit real secrets.
APP_MODE=demo
LIVE_AUTO_SEND=0
# Optional ADMIN_TOKEN: at least 24 random characters. Otherwise data/admin.key is created.
DEMO_LLM_BASE_URL=https://api.openai.com/v1
DEMO_LLM_API_KEY=
DEMO_LLM_MODEL=
DEMO_LINE_CHANNEL_SECRET=
DEMO_LINE_CHANNEL_ACCESS_TOKEN=
DEMO_META_APP_SECRET=
DEMO_META_VERIFY_TOKEN=
DEMO_META_ACCESS_TOKEN=
DEMO_META_OWN_ID=
# Set the currently authorized Graph API version explicitly.
DEMO_META_API_VERSION=
DEMO_META_GRAPH_BASE=https://graph.facebook.com
DEMO_TIKTOK_CONNECTOR_URL=
DEMO_TIKTOK_CONNECTOR_SECRET=
