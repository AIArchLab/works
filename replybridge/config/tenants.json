{
 "_comment": "Multi-tenant configuration. Adding a client is data, not code.",
 "tenants": [
  {
   "tenant_id": "tenant_primary",
   "name": "Primary tenant (illustrative)",
   "accounts": {
    "meta_instagram": {
     "account_id": "17841400000000001",
     "page_access_token": "IG_TOKEN_ENV"
    },
    "meta_facebook": {
     "account_id": "100000000000001",
     "page_access_token": "FB_TOKEN_ENV"
    },
    "line": {
     "account_id": "U0000000000000000000000000000001",
     "channel_access_token": "LINE_TOKEN_ENV"
    },
    "tiktok": {
     "account_id": "TT_BIZ_7000001",
     "access_token": "TT_TOKEN_ENV"
    }
   },
   "policy": {
    "guardrails": {
     "min_confidence": 0.65,
     "max_replies_per_thread_per_hour": 3,
     "max_reply_chars": 500,
     "quiet_hours": {
      "start": 22,
      "end": 8,
      "tz_offset_hours": 8
     },
     "blocked_patterns": [
      "(wire transfer|password|id number|credit card)",
      "(refund now|send me your password)"
     ],
     "pii_patterns": [
      "\\b09\\d{8}\\b",
      "\\b[A-Z][12]\\d{8}\\b",
      "[\\w.+-]+@[\\w-]+\\.[\\w.]+"
     ]
    },
    "persona": {
     "signature": "- Support (reply \"human\" for a person)"
    },
    "rules": [
     {
      "id": "human_handoff",
      "when": {
       "keywords": [
        "real person",
        "human",
        "agent",
        "call me"
       ]
      },
      "action": "escalate",
      "escalate_reason": "user_requested_human"
     },
     {
      "id": "price_question",
      "when": {
       "keywords": [
        "price",
        "cost",
        "quote",
        "how much"
       ]
      },
      "action": "reply_canned",
      "reply": "Hi {{author_name}}, replies are billed monthly by channel count and message volume. Share which channels you run and I can narrow the range."
     },
     {
      "id": "platform_scope",
      "when": {
       "keywords": [
        "which channels",
        "supported"
       ]
      },
      "action": "reply_canned",
      "reply": "Instagram, Facebook, LINE and TikTok are all supported, and one policy layer is shared across them."
     },
     {
      "id": "spam",
      "when": {
       "keywords": [
        "投資老師",
        "帶單",
        "免費送你",
        "crypto signal"
       ]
      },
      "action": "ignore"
     }
    ]
   }
  },
  {
   "tenant_id": "tenant_secondary",
   "name": "Second tenant (illustrative)",
   "accounts": {
    "meta_facebook": {
     "account_id": "200000000000002",
     "page_access_token": "FB2_TOKEN_ENV"
    }
   },
   "policy": {
    "guardrails": {
     "min_confidence": 0.7,
     "max_replies_per_thread_per_hour": 2,
     "max_reply_chars": 300,
     "blocked_patterns": [
      "(wire transfer|password|id number|credit card)",
      "(refund now|send me your password)"
     ]
    },
    "persona": {
     "signature": "- Support (reply \"human\" for a person)"
    },
    "rules": [
     {
      "id": "hours",
      "when": {
       "keywords": [
        "營業時間",
        "幾點開",
        "open hours"
       ]
      },
      "action": "reply_canned",
      "reply": "Thanks, a human will follow up."
     }
    ]
   }
  }
 ]
}